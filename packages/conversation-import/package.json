{
  "name": "@xiaozhuang-dsh/conversation-import",
  "version": "0.3.0",
  "description": "Native Session export plus DeepSeek conversation-history import, packaged as a standard DeepSeek Harness plugin.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "conversation-import",
    "session-export",
    "chat-migration"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niushuanan/dsh-chat-migration.git",
    "directory": "packages/conversation-import"
  },
  "homepage": "https://github.com/niushuanan/dsh-chat-migration#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.client.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-commands": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-log-export": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.1.7-0 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.1.7-0 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-log-export": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.2.1-rc.2",
    "@types/react": "~18.3.1",
    "fflate": "^0.8.2",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.1.7"
  }
}

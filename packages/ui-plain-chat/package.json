{
    "name":  "@xiaozhuang-dsh/ui-plain-chat",
    "version":  "0.3.0",
    "description":  "Sidebar action that starts or reuses a session with the shipped plain-chat preset.",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "plain-chat",
                     "sidebar"
                 ],
    "license":  "MIT",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/niushuanan/dsh-chat-migration.git",
                       "directory":  "packages/ui-plain-chat"
                   },
    "homepage":  "https://github.com/niushuanan/dsh-chat-migration#readme",
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/types/**/*.d.ts",
                  "cordis.patch.yml",
                  "README.md"
              ],
    "scripts":  {
                    "build":  "tsdown",
                    "typecheck":  "tsc -p tsconfig.json"
                },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "\u003e=4.0.0-rc \u003c5",
                             "@deepseek-ai/dsh-api-remotes":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-api-session-controller":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-locale":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-conversation":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-primitives":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-renderer":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-sidebar":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-slots":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-client-ui-workspace":  "\u003e=0.1.7-0 \u003c0.3.0-0",
                             "@deepseek-ai/dsh-session":  "\u003e=0.1.7-0 \u003c0.3.0-0"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "4.0.5",
                            "@deepseek-ai/dsh-api-remotes":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-api-session-controller":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-locale":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-conversation":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-primitives":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-renderer":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-sidebar":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-slots":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-client-ui-workspace":  "0.2.1-rc.2",
                            "@deepseek-ai/dsh-session":  "0.2.1-rc.2",
                            "@types/react":  "~18.3.1",
                            "react":  "^18.2.0"
                        },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-api-remotes",
                                              "@deepseek-ai/dsh-api-session-controller",
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-client-ui-primitives",
                                              "@deepseek-ai/dsh-client-ui-sidebar",
                                              "@deepseek-ai/dsh-client-ui-workspace"
                                          ]
                           }
            },
    "engines":  {
                    "dsh":  "\u003e=0.1.7"
                },
    "private":  true
}
